<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Frontera FormularioPaciente (análisis de CU12): flujos 6.1 (alta) y 6.3 (modificación) -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="es.uclm.esi.iso2.cliente.presentacion.FormularioPaciente"
      spacing="14" styleClass="raiz" prefWidth="560">
    <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>

    <Label fx:id="titulo" styleClass="titulo"/>
    <Label text="Los campos marcados con * son obligatorios." styleClass="nota"/>

    <GridPane hgap="12" vgap="8">
        <columnConstraints>
            <ColumnConstraints minWidth="160"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="280"/>
        </columnConstraints>

        <Label text="DNI/NIE *" GridPane.rowIndex="0"/>
        <TextField fx:id="dni" promptText="12345678Z o X1234567L" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Tarjeta sanitaria *" GridPane.rowIndex="1"/>
        <TextField fx:id="tarjeta" promptText="16 letras o dígitos" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Nombre *" GridPane.rowIndex="2"/>
        <TextField fx:id="nombre" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Apellidos *" GridPane.rowIndex="3"/>
        <TextField fx:id="apellidos" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Fecha de nacimiento" GridPane.rowIndex="4"/>
        <TextField fx:id="fechaNacimiento" promptText="dd/mm/aaaa" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Sexo" GridPane.rowIndex="5"/>
        <ComboBox fx:id="sexo" maxWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Teléfono *" GridPane.rowIndex="6"/>
        <TextField fx:id="telefono" promptText="600123456" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="Correo electrónico" GridPane.rowIndex="7"/>
        <TextField fx:id="correo" promptText="usuario@dominio.es" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

        <Label text="Dirección" GridPane.rowIndex="8"/>
        <TextArea fx:id="direccion" prefRowCount="2" wrapText="true" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
    </GridPane>

    <Label fx:id="mensaje" styleClass="mensaje-error" wrapText="true" maxWidth="Infinity"/>

    <HBox spacing="8">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="botonCancelar" text="Cancelar" cancelButton="true" onAction="#cancelar"/>
        <Button fx:id="botonGuardar" text="Guardar" defaultButton="true" onAction="#guardar"
                styleClass="boton-principal"/>
    </HBox>
</VBox>
