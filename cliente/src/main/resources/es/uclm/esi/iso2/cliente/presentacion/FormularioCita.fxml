<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Frontera FormularioCita (diseño de CU13): asignar una cita nueva o reprogramar una existente -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="es.uclm.esi.iso2.cliente.presentacion.FormularioCita"
      spacing="14" styleClass="raiz" prefWidth="560">
    <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>

    <Label fx:id="titulo" styleClass="titulo"/>
    <Label fx:id="nota" styleClass="nota" wrapText="true"/>

    <GridPane hgap="12" vgap="8">
        <columnConstraints>
            <ColumnConstraints minWidth="175"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="260"/>
        </columnConstraints>

        <Label text="DNI/NIE del paciente *" GridPane.rowIndex="0"/>
        <TextField fx:id="dni" promptText="12345678Z o X1234567L" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Tipo de prueba *" GridPane.rowIndex="1"/>
        <ComboBox fx:id="tipo" maxWidth="Infinity" promptText="Elige un tipo de prueba"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Recurso *" GridPane.rowIndex="2"/>
        <ComboBox fx:id="recurso" maxWidth="Infinity" promptText="Elige una sala o equipo"
                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Fecha *" GridPane.rowIndex="3"/>
        <TextField fx:id="fecha" promptText="dd/mm/aaaa" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Hora *" GridPane.rowIndex="4"/>
        <TextField fx:id="hora" promptText="hh:mm (de 08:00 a 20:00)" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Duración (minutos)" GridPane.rowIndex="5"/>
        <TextField fx:id="duracion" promptText="Vacío = la del tipo de prueba" GridPane.rowIndex="5"
                   GridPane.columnIndex="1"/>
    </GridPane>

    <Label fx:id="mensaje" styleClass="mensaje-error" wrapText="true" maxWidth="Infinity"/>

    <HBox spacing="8">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="botonCancelar" text="Cerrar sin guardar" cancelButton="true" onAction="#cancelar"/>
        <Button fx:id="botonGuardar" text="Guardar" defaultButton="true" onAction="#guardar"
                styleClass="boton-principal"/>
    </HBox>
</VBox>
