<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Frontera PantallaBusquedaCitas (diseño de CU13): consulta, asignación, reprogramación y cancelación -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="es.uclm.esi.iso2.cliente.presentacion.PantallaBusquedaCitas"
            styleClass="raiz">

    <top>
        <VBox styleClass="cabecera" spacing="10">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Gestión de citas" styleClass="titulo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="botonNueva" text="Nueva cita" onAction="#nuevaCita" styleClass="boton-principal"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="DNI/NIE" labelFor="$filtroDni"/>
                <TextField fx:id="filtroDni" promptText="Todos" prefColumnCount="10" onAction="#buscar"/>
                <Label text="Desde" labelFor="$filtroDesde"/>
                <TextField fx:id="filtroDesde" promptText="dd/mm/aaaa" prefColumnCount="8" onAction="#buscar"/>
                <Label text="Hasta" labelFor="$filtroHasta"/>
                <TextField fx:id="filtroHasta" promptText="dd/mm/aaaa" prefColumnCount="8" onAction="#buscar"/>
                <Label text="Estado" labelFor="$filtroEstado"/>
                <ComboBox fx:id="filtroEstado"/>
                <Button fx:id="botonBuscar" text="Buscar" defaultButton="true" onAction="#buscar"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
            <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                <placeholder><Label text="Pulsa «Buscar» para ver las citas, o asigna una nueva." wrapText="true"/></placeholder>
                <columns>
                    <TableColumn fx:id="columnaId" text="Nº" prefWidth="50"/>
                    <TableColumn fx:id="columnaDni" text="Paciente" prefWidth="100"/>
                    <TableColumn fx:id="columnaTipo" text="Prueba" prefWidth="180"/>
                    <TableColumn fx:id="columnaRecurso" text="Recurso" prefWidth="135"/>
                    <TableColumn fx:id="columnaInicio" text="Inicio" prefWidth="140"/>
                    <TableColumn fx:id="columnaFin" text="Fin" prefWidth="60"/>
                    <TableColumn fx:id="columnaEstado" text="Estado" prefWidth="100"/>
                    <TableColumn fx:id="columnaMotivo" text="Motivo de cancelación" prefWidth="195"/>
                </columns>
            </TableView>
            <HBox spacing="8">
                <Button fx:id="botonReprogramar" text="Reprogramar" onAction="#reprogramar" disable="true"/>
                <Button fx:id="botonCancelarCita" text="Cancelar cita" onAction="#cancelarCita" disable="true"
                        styleClass="boton-peligro"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <Label fx:id="mensaje" styleClass="barra-mensaje" maxWidth="Infinity" wrapText="true"/>
    </bottom>
</BorderPane>
