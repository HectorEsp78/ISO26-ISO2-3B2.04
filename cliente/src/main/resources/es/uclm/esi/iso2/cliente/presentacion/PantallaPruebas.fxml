<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Frontera PantallaRegistroPruebas (CU10): flujos 6.1 a 6.6 -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="es.uclm.esi.iso2.cliente.presentacion.PantallaPruebas"
            styleClass="raiz">

    <top>
        <VBox styleClass="cabecera" spacing="4">
            <Label text="Registro de pruebas" styleClass="titulo"/>
            <Label fx:id="etiquetaMedico" styleClass="nota"/>
        </VBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="Solicitudes pendientes">
                <VBox spacing="10">
                    <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="DNI/NIE"/>
                        <TextField fx:id="campoDniPendientes" promptText="12345678Z" prefColumnCount="12"
                                   onAction="#buscarPendientes"/>
                        <Button fx:id="botonPendientes" text="Buscar" defaultButton="true"
                                onAction="#buscarPendientes"/>
                    </HBox>
                    <TableView fx:id="tablaPendientes" VBox.vgrow="ALWAYS"/>
                    <HBox spacing="8">
                        <Button fx:id="botonRealizada" text="Registrar realización…" disable="true"
                                onAction="#registrarRealizacion" styleClass="boton-principal"/>
                        <Button fx:id="botonCancelada" text="Cancelar prueba…" disable="true"
                                onAction="#registrarCancelacion" styleClass="boton-peligro"/>
                    </HBox>
                </VBox>
            </Tab>
            <Tab text="Pruebas registradas">
                <VBox spacing="10">
                    <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="DNI/NIE"/>
                        <TextField fx:id="filtroDni" prefColumnCount="10" onAction="#buscarPruebas"/>
                        <Label text="Solicitud"/>
                        <TextField fx:id="filtroSolicitud" prefColumnCount="5" onAction="#buscarPruebas"/>
                        <Label text="Desde"/>
                        <TextField fx:id="filtroDesde" promptText="dd/mm/aaaa" prefColumnCount="9"
                                   onAction="#buscarPruebas"/>
                        <Label text="Hasta"/>
                        <TextField fx:id="filtroHasta" promptText="dd/mm/aaaa" prefColumnCount="9"
                                   onAction="#buscarPruebas"/>
                        <ComboBox fx:id="filtroEstado"/>
                        <Button fx:id="botonBuscarPruebas" text="Buscar" onAction="#buscarPruebas"/>
                    </HBox>
                    <TableView fx:id="tablaPruebas" VBox.vgrow="ALWAYS"/>
                    <HBox spacing="8">
                        <Button fx:id="botonDetalle" text="Ver detalle…" disable="true" onAction="#verDetalle"/>
                    </HBox>
                </VBox>
            </Tab>
        </TabPane>
    </center>

    <bottom>
        <Label fx:id="mensaje" styleClass="barra-mensaje" maxWidth="Infinity" wrapText="true"/>
    </bottom>
</BorderPane>
